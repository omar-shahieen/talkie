# Database configuration
# Defaults to true outside production and false in production. Never enable in production.
DB_SYNC=true
DB_RETRY_ATTEMPTS=10
DB_RETRY_DELAY_MS=3000
DB_CONNECT_TIMEOUT_PER_ATTEMPT_MS=5000

# Postgres container configuration
POSTGRES_USER=postgres
POSTGRES_DB=talkie

# app configuration
NODE_ENV=development
APP_NAME=talkie
PORT=3000

# google oauth configuration
GOOGLE_CLIENT_ID=845252124968-252ggitursa8e0v06h3i4dsjh91slmko.apps.googleusercontent.com
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
FRONTEND_OAUTH_REDIRECT_URL=http://localhost:8080/oauth

# frontend configuration
FRONTEND_END_URL=http://localhost:8080/
# Allowed browser origins (comma-separated) for HTTP + Socket.IO CORS in production.
# Falls back to FRONTEND_END_URL. Non-production allows any origin.
CORS_ORIGINS=http://localhost:8080

# Graceful shutdown (ms)
SHUTDOWN_TIMEOUT_MS=10000
# Time /health reports 503 before closing (defaults: 5000 in production, 0 otherwise)
SHUTDOWN_DRAIN_MS=5000
WORKER_SHUTDOWN_TIMEOUT_MS=30000

# email configuration
MAIL_FROM=om039919@gmail.com

# Mail configuration
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=587

# Cache Configuration
CACHE_TTL=5000

# Object Storage (Cloudflare R2)
S3_ENDPOINT=https://319c5421a0fad85373d5251bb3bef0ef.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET_NAME=talkie
S3_PUBLIC_URL=https://pub-9d2cfb4b880140b29ba06d382c363794.r2.dev
